          "script": {
            "exec": [
              "const eventId = pm.environment.get(\"current_event_id\");\r",
              "\r",
              "if (!eventId) {\r",
              "    throw new Error(\"current_event_id is not set in environment\");\r",
              "}\r",
              "\r",
              "const body = {\r",
              "    event: Number(eventId),\r",
              "    text: \"Test comment\"\r",
              "};\r",
              "\r",
              "pm.environment.set(\"commentBody\", JSON.stringify(body));"
